{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://quarka.org/schema/assistant/definitions/permissions.schema.json",
  "title": "Permissions",
  "description": "Config API permissions. Array elements are category names (goals / siteinfo) or custom_data store names. Required when config_read / config_write steps are used.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "config_read": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "config_write": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
